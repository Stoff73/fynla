APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Asset URL for subfolder deployment (production only)
# For local development, leave this commented out
# For production at https://csjones.co/fps, set to: https://csjones.co/fps
# ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MARKETING_FROM_ADDRESS="marketing@fynla.org"
MAIL_MARKETING_FROM_NAME="Fynla"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:8000

VITE_APP_NAME="${APP_NAME}"

# API Base URL for frontend (leave empty for local dev, set for production)
# Local: leave commented out (will use http://127.0.0.1:8000)
# Production: set to your domain (e.g., https://csjones.co/fps)
# VITE_API_BASE_URL=

# Revolut Payment Integration
REVOLUT_API_KEY=
REVOLUT_PUBLIC_KEY=
REVOLUT_WEBHOOK_SECRET=
REVOLUT_SANDBOX=true
VITE_REVOLUT_PUBLIC_KEY=${REVOLUT_PUBLIC_KEY}
VITE_REVOLUT_SANDBOX=${REVOLUT_SANDBOX}
PAYMENT_ENABLED=false

# Apple App Store Server integration (server-only; sandbox on development)
APPLE_STORE_ENVIRONMENT=sandbox
APPLE_STORE_APP_APPLE_ID=

# Native iOS runtime policy (new purchases remain disabled until explicitly enabled)
NATIVE_POLICY_ENVIRONMENT=staging
NATIVE_STAGING_MINIMUM_VERSION=1.0.0
NATIVE_STAGING_MINIMUM_BUILD=1
NATIVE_PRODUCTION_MINIMUM_VERSION=1.0.0
NATIVE_PRODUCTION_MINIMUM_BUILD=1
NATIVE_STOREKIT_PURCHASE_ENABLED=false
NATIVE_APP_STORE_URL=https://apps.apple.com/app/fynla
APPLE_STORE_PYTHON_EXECUTABLE=
APPLE_STORE_KEY_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_PRIVATE_KEY_PATH=

# Analytics (Plausible Cloud - privacy-first, no cookies, GDPR-compliant)
ANALYTICS_ENABLED=false
PLAUSIBLE_DOMAIN=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Plausible Analytics (frontend)
VITE_PLAUSIBLE_DOMAIN=

# Google Analytics measurement id (frontend). Leave EMPTY for local development
# and any environment without its own property — unset means no analytics is
# loaded at all. Never put the production id here: that is what sent developer
# and test traffic into the live property (W-0047).
VITE_GA_ID=

# AI audit hash-chain HMAC key (S0.12). Falls back to APP_KEY when unset.
AI_AUDIT_HMAC_KEY=

# AI Provider: 'anthropic' or 'xai'
AI_PROVIDER=anthropic

# Anthropic (legacy)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ADVANCED_CHAT_MODEL=claude-sonnet-4-6-20260320
ANTHROPIC_OPUS_MODEL=claude-opus-4-7

# xAI Grok
XAI_API_KEY=
XAI_CHAT_MODEL=grok-4-1-fast-reasoning
XAI_ADVANCED_CHAT_MODEL=grok-4-1-fast-reasoning
XAI_VISION_MODEL=grok-4-1-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1

AGENT_INTERNAL_TOKEN=

# Marketing Pipeline (Stage 1 = detect published Insight articles daily and hand
# off to Stage 2 for script generation. Master switch: leave false until
# downstream stages are wired up, otherwise the scheduler will dispatch jobs
# that log-and-noop.)
PIPELINE_ENABLED=false
PIPELINE_DETECT_SCHEDULE=07:00
PIPELINE_QUEUE=pipeline
# Recommended development identity for the future pipeline preflight command.
PIPELINE_RUNNER_NAME=csjones-development
PIPELINE_LOG_LEVEL=debug

# How often (minutes) the detect commands poll Drive / published articles.
PIPELINE_POLL_FREQUENCY_MINUTES=5

# Real-time Drive trigger (optional). Set on dev/live only — Google cannot reach
# localhost. After setting, run `php artisan pipeline:drive-watch` once.
PIPELINE_DRIVE_WEBHOOK_URL=
PIPELINE_DRIVE_WEBHOOK_TOKEN=

# Marketing Pipeline — Google service account. Store the downloaded JSON key
# outside the public web root and put only its absolute server path here.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Marketing Pipeline — Google Drive + Sheets targets
PIPELINE_GOOGLE_DRIVE_FOLDER_ID=
PIPELINE_GOOGLE_TRACKER_SHEET_ID=

# Marketing Pipeline — Cost caps (GBP, unified across all AI vendors)
PIPELINE_COST_PER_REQUEST_GBP=0.30
PIPELINE_COST_PER_DAY_GBP=1.00

# Marketing Pipeline — script-ready notification recipient
PIPELINE_NOTIFICATION_TO=marketing@fynla.org

# Marketing Pipeline — Local Whisper (Stage 3, transcription)
PIPELINE_WHISPER_BINARY=whisper
PIPELINE_WHISPER_MODEL=small
PIPELINE_WHISPER_LANGUAGE=en
PIPELINE_VIDEO_ENCODER=libx264

# Marketing Pipeline — Video (Stage 3)
PIPELINE_VIDEO_DETECT_SCHEDULE=07:30
PIPELINE_VIDEO_AUDIT_DAYS=365
PIPELINE_SIGNED_URL_TTL_DAYS=30

# Marketing Pipeline — Clip approval gate (Stage 3.5)
# When enabled, ProcessVideoJob sends clips for approval before
# ComposePostsJob runs. Anything still pending N minutes before its
# scheduled post time is auto-approved by pipeline:auto-approve-clips.
PIPELINE_CLIP_APPROVAL_ENABLED=true
PIPELINE_CLIP_AUTO_APPROVE_MINUTES=10
PIPELINE_CLIP_AUTO_APPROVE_CRON_MINUTES=5

# Marketing Pipeline — Social (Stage 4). Composition happens automatically
# after clips render; leave false to require manual dispatch during testing.
PIPELINE_COMPOSE_AFTER_RENDER=false
PIPELINE_HASHTAG_COUNT=3
# Dry-run: compose + record the schedule but never post to Buffer/social.
PIPELINE_SOCIAL_DRY_RUN=true

# Marketing Pipeline — Buffer (Stage 4 posting mechanism)
# Access token from https://publish.buffer.com/ → Settings → Integrations → API
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_INSTAGRAM=
BUFFER_PROFILE_FACEBOOK=
BUFFER_PROFILE_TIKTOK=

# Marketing Pipeline — Google Analytics (Stage 4 weekly report)
# GA4 property ID from analytics.google.com → Admin → Property Settings
PIPELINE_GA_PROPERTY_ID=530097849
PIPELINE_GA_LOOKBACK_DAYS=56

# Marketing Pipeline — Weekly performance report
PIPELINE_WEEKLY_REPORT_TO=marketing@fynla.org
PIPELINE_WEEKLY_REPORT_DAY=1
PIPELINE_WEEKLY_REPORT_TIME=09:00

# Stage 5 — Word doc auto-ingest schedule + dev→prod gate
PIPELINE_ARTICLE_DOCS_SCHEDULE=06:45
PIPELINE_DEV_TO_PROD_MIN_HOURS=1

# Stage 5 — cross-env sync (local machine sets URL_* + TOKEN_*)
PIPELINE_SYNC_URL_DEV=https://csjones.co/fynla
PIPELINE_SYNC_TOKEN_DEV=
PIPELINE_SYNC_URL_PROD=https://fynla.org
PIPELINE_SYNC_TOKEN_PROD=
# On each target env: set PIPELINE_SYNC_TOKEN to the value the *sender*
# sends for that env (i.e. it matches PIPELINE_SYNC_TOKEN_DEV on the
# dev server, and PIPELINE_SYNC_TOKEN_PROD on the prod server)
PIPELINE_SYNC_TOKEN=
# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Apple Push Notification service (token authentication)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# Admin notification recipients (comma-separated email list — e.g. bug reports, audit alerts)
ADMIN_EMAILS=

# In-app bug reports → GitHub issues (autonomous Claude fix loop).
# Token needs only Issues: write on the target repo. Disabled until set.
GITHUB_BUG_ISSUE_TOKEN=
GITHUB_BUG_ISSUE_REPO=Stoff73/fynla
GITHUB_BUG_ISSUE_ENABLED=false

# Internal agent-to-service auth token (server-only; signed requests between agents and microservices)
AGENT_INTERNAL_TOKEN=

# OpenAI (used by select document-extraction pipelines as a dual-provider fallback)
OPENAI_API_KEY=

# SSH key passphrase (deployment tooling only — never set in production)
SSH_PASSPHRASE=

# Insights CMS admin tools — enables the Vue-side authoring UI (admin-only)
VITE_INSIGHTS_CMS_ENABLED=false
