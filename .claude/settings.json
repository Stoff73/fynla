{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=\"$CLAUDE_FILE_PATH\"; if [[ \"$filepath\" == *.php ]]; then ./vendor/bin/pint \"$filepath\" --quiet 2>/dev/null; fi"
          },
          {
            "type": "command",
            "command": "python3 /Users/CSJ/Desktop/fynla/.claude/hooks/security_reminder_hook.py"
          },
          {
            "type": "command",
            "command": "bash /Users/CSJ/Desktop/fynla/.claude/hooks/vault_reminder_hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=\"$CLAUDE_FILE_PATH\"; for p in .env .env.production composer.lock package-lock.json; do if [[ \"$(basename \"$filepath\")\" == \"$p\" ]]; then echo \"BLOCKED: $p is a protected file. Edit manually if needed.\"; exit 2; fi; done"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/CSJ/Desktop/fynla/.claude/hooks/eval-gate.sh",
            "timeout": 30,
            "statusMessage": "Evaluation gate checking..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "fynla-dev-skills@fynla-marketplace": true,
    "fynla-compliance@fynla-marketplace": true,
    "fynla-design@fynla-marketplace": true,
    "fynla-ops@fynla-marketplace": true
  },
  "extraKnownMarketplaces": {
    "fynla-marketplace": {
      "source": {
        "source": "github",
        "repo": "Stoff73/fynla"
      },
      "autoUpdate": true
    }
  }
}
