{
  "id": "mitchell_advice_estate_iht",
  "category": "01-query-types",
  "persona": "peak_earners",
  "is_mutating": false,
  "description": "David Mitchell asks about IHT exposure. Classifier resolves to ESTATE_IHT (primary), property (related), modules: [estate, property]. Universal KYC passes. peak_earners has multiple properties + investment + pension assets, so EstateAgent reaches the happy IHT calculation path. LLM should reference the user's NRB / RNRB usage and signpost FCA advice.",
  "input": {
    "turns": [
      {"user": "What is my inheritance tax exposure?", "current_route": "/estate"}
    ]
  },
  "expected_classification_shape": {
    "primary": "estate_iht",
    "related": ["property"],
    "modules": ["estate", "property"]
  },
  "expected_response_mode": "recommendation",
  "expected_engine_call_level": "module",
  "expected_kyc_state": "passed",
  "expected_tool_calls": [
    {"tool": "get_tax_information", "args": {"category": "inheritance_tax"}, "required": true, "result_path": "happy"},
    {"tool": "get_module_analysis", "args": {"module": "estate"}, "required": true, "result_path": "happy"},
    {"tool": "list_records", "args": {"entity_type": "property"}, "required": true, "result_path": "happy"}
  ],
  "expected_tool_calls_absent": [
    "create_estate_gift",
    "create_will",
    "update_record",
    "delete_record",
    "delegate_to_capture",
    "navigate_to_page"
  ],
  "expected_sse_events": {
    "must_contain_types": ["title", "content", "tool_use", "done"],
    "must_emit_exactly_once": ["done", "title"],
    "must_not_emit": ["persona_state_change", "handoff", "consent_required", "error"],
    "content_event_minimum": 5,
    "tool_use_count_min": 3,
    "tool_use_count_max": 10
  },
  "expected_assistant_text": {
    "must_contain_substrings": [
      "For regulated advice personal to your circumstances, speak to a qualified financial adviser."
    ],
    "must_contain_at_least_one_of": [
      ["inheritance tax", "IHT", "nil rate band", "estate"]
    ],
    "must_not_contain_substrings": ["I think you should", "I'd recommend", "In my opinion", "you should definitely"],
    "minimum_length_chars": 200,
    "maximum_length_chars": 3000
  },
  "expected_db_writes": {
    "expected_count": 0,
    "expected_no_writes_to": ["properties", "wills", "estate_gifts", "users"]
  },
  "expected_engine_trace": {
    "must_contain": [
      {"event": "AgentDecision", "decisionPoint": "classify_query"},
      {"event": "AgentDecision", "decisionPoint": "response_mode", "outcome": "recommendation"},
      {"event": "AgentDecision", "decisionPoint": "engine_call_level", "outcome": "module"},
      {"event": "GateChecked", "gate": "kyc", "module": "global", "passed": true},
      {"event": "GateChecked", "gate": "kyc", "module": "estate", "passed": true},
      {"event": "EngineCalled", "engine": "estate_analysis"}
    ],
    "must_not_contain": [
      {"event": "EngineCalled", "engine": "orchestrate_analysis"}
    ]
  },
  "expected_http_log": {
    "calls": 4,
    "must_have_status_200": ["login", "create_conversation", "send_message", "logout"]
  },
  "timing_budget_ms": {
    "anthropic": {"happy": 9000},
    "xai": {"happy": 22000}
  },
  "tags": ["regression-band-0", "recommendation-mode", "estate", "property", "peak_earners", "happy-path"]
}
