{
  "id": "mitchell_advice_retirement_contribution",
  "category": "01-query-types",
  "persona": "peak_earners",
  "is_mutating": false,
  "description": "David Mitchell asks about pension contributions. Classifier resolves to RETIREMENT_CONTRIBUTION (primary), tax_optimisation + savings_emergency + affordability (related), modules: [retirement, tax, savings, income]. Universal KYC passes. peak_earners has SIPP + NHS pensions, so RetirementAgent reaches the happy projection path. LLM should reference the user's actual pension balances and signpost FCA advice.",
  "input": {
    "turns": [
      {"user": "Should I increase my pension contribution?", "current_route": "/net-worth/retirement"}
    ]
  },
  "expected_classification_shape": {
    "primary": "retirement_contribution",
    "related": ["tax_optimisation", "savings_emergency", "affordability"],
    "modules": ["retirement", "tax", "savings", "income"]
  },
  "expected_response_mode": "recommendation",
  "expected_engine_call_level": "module",
  "expected_kyc_state": "passed",
  "expected_tool_calls": [
    {"tool": "get_tax_information", "args": {"category": "pension_allowances"}, "required": true, "result_path": "happy"},
    {"tool": "get_tax_information", "args": {"category": "income_definitions"}, "required": true, "result_path": "happy"},
    {"tool": "get_module_analysis", "args": {"module": "retirement"}, "required": true, "result_path": "happy"},
    {"tool": "list_records", "args": {"entity_type": "dc_pension"}, "required": true, "result_path": "happy"}
  ],
  "expected_tool_calls_absent": [
    "create_pension",
    "update_record",
    "delete_record",
    "delegate_to_capture",
    "navigate_to_page"
  ],
  "expected_sse_events": {
    "must_contain_types": ["title", "content", "tool_use", "done"],
    "must_emit_exactly_once": ["done", "title"],
    "must_not_emit": ["persona_state_change", "handoff", "consent_required", "error"],
    "content_event_minimum": 5,
    "tool_use_count_min": 4,
    "tool_use_count_max": 12
  },
  "expected_assistant_text": {
    "must_contain_substrings": [
      "For regulated advice personal to your circumstances, speak to a qualified financial adviser."
    ],
    "must_contain_at_least_one_of": [
      ["pension", "contribution", "annual allowance", "tax relief"]
    ],
    "must_not_contain_substrings": ["I think you should", "I'd recommend", "In my opinion", "you should definitely"],
    "minimum_length_chars": 200,
    "maximum_length_chars": 3000
  },
  "expected_db_writes": {
    "expected_count": 0,
    "expected_no_writes_to": ["dc_pensions", "retirement_profiles", "users"]
  },
  "expected_engine_trace": {
    "must_contain": [
      {"event": "AgentDecision", "decisionPoint": "classify_query"},
      {"event": "AgentDecision", "decisionPoint": "response_mode", "outcome": "recommendation"},
      {"event": "AgentDecision", "decisionPoint": "engine_call_level", "outcome": "module"},
      {"event": "GateChecked", "gate": "kyc", "module": "global", "passed": true},
      {"event": "GateChecked", "gate": "kyc", "module": "retirement", "passed": true},
      {"event": "EngineCalled", "engine": "retirement_analysis"}
    ],
    "must_not_contain": [
      {"event": "EngineCalled", "engine": "orchestrate_analysis"}
    ]
  },
  "expected_http_log": {
    "calls": 4,
    "must_have_status_200": ["login", "create_conversation", "send_message", "logout"]
  },
  "timing_budget_ms": {
    "anthropic": {"happy": 9000},
    "xai": {"happy": 22000}
  },
  "tags": ["regression-band-0", "recommendation-mode", "retirement", "tax", "peak_earners", "happy-path"]
}
