{
  "id": "mitchell_factual_income",
  "category": "01-query-types",
  "persona": "peak_earners",
  "is_mutating": false,
  "description": "David Mitchell asks a factual question about income. Classifier resolves to INCOME (primary), modules: [income]. INCOME is the one advice-type primary that maps to factual response mode and factual engine_call_level (KYC bypassed). No FCA signposting; LLM should just answer the data question.",
  "input": {
    "turns": [
      {"user": "How much do I earn?", "current_route": "/valuable-info?section=income"}
    ]
  },
  "expected_classification_shape": {
    "primary": "income",
    "related": [],
    "modules": ["income"]
  },
  "expected_response_mode": "factual",
  "expected_engine_call_level": "factual",
  "expected_kyc_state": "bypass",
  "expected_tool_calls": [
    {"tool": "get_tax_information", "args": {"category": "income_tax"}, "required": false, "result_path": "happy"}
  ],
  "expected_tool_calls_absent": [
    "create_record",
    "update_record",
    "delete_record",
    "delegate_to_capture",
    "navigate_to_page",
    "get_module_analysis",
    "get_recommendations",
    "generate_financial_plan"
  ],
  "expected_sse_events": {
    "must_contain_types": ["title", "content", "done"],
    "must_emit_exactly_once": ["done", "title"],
    "must_not_emit": ["persona_state_change", "handoff", "consent_required", "error"],
    "content_event_minimum": 1,
    "tool_use_count_min": 0,
    "tool_use_count_max": 6
  },
  "expected_assistant_text": {
    "must_contain_at_least_one_of": [
      ["£", "income", "earn", "salary"]
    ],
    "must_not_contain_substrings": [
      "For regulated advice personal to your circumstances, speak to a qualified financial adviser.",
      "I think you should",
      "I'd recommend",
      "In my opinion"
    ],
    "minimum_length_chars": 50,
    "maximum_length_chars": 2000
  },
  "expected_db_writes": {
    "expected_count": 0,
    "expected_no_writes_to": ["users", "ai_conversations"]
  },
  "expected_engine_trace": {
    "must_contain": [
      {"event": "AgentDecision", "decisionPoint": "classify_query"},
      {"event": "AgentDecision", "decisionPoint": "response_mode", "outcome": "factual"},
      {"event": "AgentDecision", "decisionPoint": "engine_call_level", "outcome": "factual"}
    ],
    "must_not_contain": [
      {"event": "EngineCalled", "engine": "orchestrate_analysis"},
      {"event": "GateChecked", "gate": "kyc", "module": "global"}
    ]
  },
  "expected_http_log": {
    "calls": 4,
    "must_have_status_200": ["login", "create_conversation", "send_message", "logout"]
  },
  "timing_budget_ms": {
    "anthropic": {"factual": 5000},
    "xai": {"factual": 12000}
  },
  "tags": ["regression-band-0", "factual-mode", "income", "peak_earners"]
}
