{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fynla.org/schemas/browser-acceptance-manifest.json",
    "title": "Fynla agent browser acceptance manifest",
    "$comment": "Cross-document step matching, URL credential checks, unique surface names, and file-system evidence checks are enforced by scripts/quality/validate-acceptance.mjs.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "finding_ids",
        "environment",
        "user",
        "surfaces",
        "negative_assertions",
        "cleanup"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "environment": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "user_visible": {
            "type": "boolean",
            "default": true
        },
        "user": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "email_ref"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "email_ref": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                }
            }
        },
        "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/surface"
            }
        },
        "negative_assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "cleanup": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "$defs": {
        "surface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "start_url",
                "steps"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "start_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://\\S+$"
                },
                "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/step"
                    }
                }
            }
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action",
                "target",
                "assert",
                "evidence"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "minLength": 1
                },
                "target": {
                    "type": "string",
                    "minLength": 1
                },
                "assert": {
                    "type": "string",
                    "minLength": 1
                },
                "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))(?!.*\\u0000).+$"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "required": [
                    "user_visible"
                ],
                "properties": {
                    "user_visible": {
                        "const": false
                    }
                }
            },
            "then": {},
            "else": {
                "properties": {
                    "surfaces": {
                        "allOf": [
                            {
                                "contains": {
                                    "type": "object",
                                    "required": [
                                        "name"
                                    ],
                                    "properties": {
                                        "name": {
                                            "const": "desktop"
                                        }
                                    }
                                }
                            },
                            {
                                "contains": {
                                    "type": "object",
                                    "required": [
                                        "name"
                                    ],
                                    "properties": {
                                        "name": {
                                            "const": "mobile"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    ]
}
