{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fynla.org/schemas/browser-acceptance-result.json",
    "title": "Fynla agent browser acceptance result",
    "$comment": "Exact ordered manifest-step matching, manifest-origin binding, release-SHA equality, evidence inventory containment, and evidence-file existence are enforced by scripts/quality/validate-acceptance.mjs.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "manifest_id",
        "commit_sha",
        "started_at",
        "finished_at",
        "environment_url",
        "browser",
        "viewport",
        "status",
        "steps",
        "negative_assertions",
        "evidence"
    ],
    "properties": {
        "manifest_id": {
            "type": "string",
            "minLength": 1
        },
        "commit_sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "started_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "finished_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "environment_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://\\S+$"
        },
        "browser": {
            "$ref": "#/$defs/browser"
        },
        "viewport": {
            "$ref": "#/$defs/viewport"
        },
        "status": {
            "$ref": "#/$defs/status"
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/stepResult"
            }
        },
        "negative_assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/assertionResult"
            }
        },
        "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/evidencePath"
            }
        },
        "diagnostic_notes": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/diagnosticNote"
            }
        }
    },
    "$defs": {
        "status": {
            "type": "string",
            "enum": [
                "passed",
                "failed",
                "blocked"
            ]
        },
        "browser": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "width",
                "height"
            ],
            "properties": {
                "width": {
                    "type": "integer",
                    "minimum": 1
                },
                "height": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "evidencePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))(?!.*\\u0000).+$"
        },
        "stepResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "surface",
                "action",
                "target",
                "assertion",
                "status",
                "evidence"
            ],
            "properties": {
                "surface": {
                    "type": "string",
                    "minLength": 1
                },
                "action": {
                    "type": "string",
                    "minLength": 1
                },
                "target": {
                    "type": "string",
                    "minLength": 1
                },
                "assertion": {
                    "type": "string",
                    "minLength": 1
                },
                "observed": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "$ref": "#/$defs/status"
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/evidencePath"
                    }
                }
            }
        },
        "assertionResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "assertion",
                "status",
                "evidence"
            ],
            "properties": {
                "assertion": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "$ref": "#/$defs/status"
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/evidencePath"
                    }
                }
            }
        },
        "diagnosticNote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "note",
                "redacted"
            ],
            "properties": {
                "note": {
                    "type": "string",
                    "minLength": 1
                },
                "redacted": {
                    "const": true
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "required": [
                    "status"
                ],
                "properties": {
                    "status": {
                        "const": "passed"
                    }
                }
            },
            "then": {
                "properties": {
                    "steps": {
                        "items": {
                            "type": "object",
                            "required": [
                                "status"
                            ],
                            "properties": {
                                "status": {
                                    "const": "passed"
                                }
                            }
                        }
                    },
                    "negative_assertions": {
                        "items": {
                            "type": "object",
                            "required": [
                                "status"
                            ],
                            "properties": {
                                "status": {
                                    "const": "passed"
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}
