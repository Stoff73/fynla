# =============================================================================
# Fynla v0.4.5 - Production .htaccess for SUBDIRECTORY Deployment
# =============================================================================
# Configured for: https://csjones.co/fynla (subdirectory deployment)
# =============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # =============================================================================
    # SUBDIRECTORY Deployment - /fynla prefix required
    # =============================================================================
    RewriteBase /fynla/

    # =============================================================================
    # Handle Authorization Header
    # =============================================================================
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # =============================================================================
    # Mark API requests so mod_headers can force `no-store` on the response.
    # MUST be before the front-controller [L] rule below, otherwise the rewrite
    # phase terminates first and this rule never fires. Path is post-RewriteBase
    # (so `^api/` matches `/fynla/api/...`).
    # =============================================================================
    RewriteRule ^api/ - [E=FYNLA_API:1]

    # =============================================================================
    # Force HTTPS
    # =============================================================================
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # =============================================================================
    # Redirect Trailing Slashes If Not A Folder
    # =============================================================================
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # =============================================================================
    # Send Requests To Front Controller
    # =============================================================================
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# =============================================================================
# Security Headers
# =============================================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    # HSTS, Content-Security-Policy, and Permissions-Policy are set by
    # app/Http/Middleware/SecurityHeaders.php (richer, app-aware allowlist
    # for Revolut, Google Fonts, analytics, Meta Pixel, etc.). Do NOT add
    # them here — Apache's Header set runs after PHP and would overwrite
    # the middleware's values, blocking the Revolut widget on /checkout.
</IfModule>

# =============================================================================
# Prevent Access to Sensitive Files
# =============================================================================
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Block access to .git directories (using RewriteRule for shared hosting compatibility)
# DirectoryMatch is not permitted in .htaccess on SiteGround shared hosting — it
# causes a 500 Internal Server Error with "DirectoryMatch not allowed here".
RewriteRule ^\.git - [F,L]

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# =============================================================================
# Disable Directory Listing & Allow Symlink Traversal
# =============================================================================
# `public/storage` is the Laravel `storage:link` symlink to `storage/app/public`
# and is intentionally web-accessible (article cover images, user uploads, etc.).
# Apache 403s symlink traversal unless FollowSymLinks (or the more secure
# SymLinksIfOwnerMatch) is enabled. SiteGround restricts FollowSymLinks on
# shared hosting, so we use SymLinksIfOwnerMatch — both link and target are
# owned by the site user, so the resolution succeeds.
# Do NOT add a `RedirectMatch 403 ^/fynla/storage/` rule — only `storage/app/public`
# is exposed via the symlink; private files under storage/app, storage/logs,
# storage/framework remain unreachable because no route maps to them.
Options -Indexes +SymLinksIfOwnerMatch

# =============================================================================
# API responses must not be cached by any proxy (SiteGround edge / CDN)
# =============================================================================
# Some upstream proxies have been observed caching /fynla/api/insights as
# text/html content, ignoring `Cache-Control: private` set by Laravel and
# serving a stale response site-wide. The env FYNLA_API is set inside the
# main mod_rewrite block above (must run before the front-controller [L]
# rule terminates the rewrite phase). When the rewrite forwards to
# index.php, Apache exposes the env as both FYNLA_API and REDIRECT_FYNLA_API
# depending on phase — match both.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, private, must-revalidate, max-age=0" env=FYNLA_API
    Header always set Pragma "no-cache" env=FYNLA_API
    Header always set Expires "0" env=FYNLA_API
    Header always set Cache-Control "no-store, no-cache, private, must-revalidate, max-age=0" env=REDIRECT_FYNLA_API
    Header always set Pragma "no-cache" env=REDIRECT_FYNLA_API
    Header always set Expires "0" env=REDIRECT_FYNLA_API
</IfModule>

# =============================================================================
# Compression
# =============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =============================================================================
# Browser Caching
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# =============================================================================
# Character Encoding
# =============================================================================
AddDefaultCharset UTF-8
