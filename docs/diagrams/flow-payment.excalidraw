      "versionNonce": 719636319,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gotcha: Revolut fires onSuccess while order is 'processing' \u2014 confirmPayment must accept that state. Launch pricing uses DiscountCode not plan price. Sandbox is csjones.co/fynla only.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Gotcha: Revolut fires onSuccess while order is 'processing' \u2014 confirmPayment must accept that state. Launch pricing uses DiscountCode not plan price. Sandbox is csjones.co/fynla only.",
      "lineHeight": 1.25
    }
