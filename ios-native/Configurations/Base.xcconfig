IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIUserInterfaceStyle = Light
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_ENTITLEMENTS = Fynla/Fynla.entitlements

// Personal signing overrides (e.g. DEVELOPMENT_TEAM) live in a git-ignored
// Local.xcconfig next to this file — never commit a developer team ID.
// See ios-native/TESTFLIGHT.md for how to create it.
#include? "Local.xcconfig"
